{{/* gotype: entgo.io/ent/entc/gen.typeScope */}}

{{/* Template for adding Property Graph support to the generated code. */}}
{{/* This template uses extensions to inject property graph functionality into individual entity query files. */}}

{{ define "dialect/sql/import/additional/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		"strings"
		"entgo.io/ent/dialect/sql/sqlpgq"
	{{- end }}
{{ end }}

{{ define "dialect/sql/query/fields/additional/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		// pgMode holds the property graph execution mode for this query
		pgMode *PropertyGraphMode
		// pgPredicates holds property graph predicate metadata for conversion
		pgPredicates []*PropertyGraphPredicate
	{{- end }}
{{ end }}

{{/* Extension to modify the Where() method to be property graph-aware */}}
{{ define "dialect/sql/query/Where/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		// If in property graph mode, extract predicate metadata for property graph conversion
		if {{ $.QueryReceiver }}.pgMode != nil && {{ $.QueryReceiver }}.pgMode.enabled {
			{{ $.QueryReceiver }}.extractPropertyGraphPredicates(ps...)
		}
	{{- end }}
{{ end }}

{{ define "dialect/sql/query/additional/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		{{ $pkg := base $.Config.Package }}
		{{ $builder := $.QueryName }}
		{{ $receiver := $.QueryReceiver }}

		// extractPropertyGraphPredicates extracts metadata from predicates for property graph queries.
		// This is called automatically when Where() is used in property graph mode.
		func ({{ $receiver }} *{{ $builder }}) extractPropertyGraphPredicates(ps ...predicate.{{ $.Name }}) {
			// For each predicate, we'll try to identify known patterns and extract metadata
			// This approach is much simpler than parsing SQL strings
			
			// Create a dummy selector to capture the predicate effects
			sel := sql.Select().From(sql.Table({{ $.Package }}.Table))
			for _, p := range ps {
				p(sel)
			}
			
			// Extract WHERE clause for simple parsing
			if where := sel.P(); where != nil {
				{{ $receiver }}.parseSimplePredicates(where)
			}
		}

		// parseSimplePredicates handles basic equality predicates for property graphs.
		// This is much simpler than the previous approach - just handles common cases.
		func ({{ $receiver }} *{{ $builder }}) parseSimplePredicates(where *sql.Predicate) {
			query, args := where.Query()
			
			// Handle single-argument equality predicates (most common case)
			if len(args) == 1 {
				{{- range $f := $.Fields }}
				// Check for {{ $f.Name }} field
				if strings.Contains(query, "`{{ $f.StorageKey }}`") {
					{{ $receiver }}.pgPredicates = append({{ $receiver }}.pgPredicates, &PropertyGraphPredicate{
						Field:     {{ printf "%q" $f.StorageKey }},
						Operation: "eq",
						Value:     args[0],
					})
				}
				{{- end }}
				
				{{ if $.HasOneFieldID }}
				// Handle ID field specifically (most common case)
				if strings.Contains(query, "`{{ $.ID.StorageKey }}`") || strings.Contains(query, "`id`") {
					{{ $receiver }}.pgPredicates = append({{ $receiver }}.pgPredicates, &PropertyGraphPredicate{
						Field:     {{ printf "%q" $.ID.StorageKey }},
						Operation: "eq", 
						Value:     args[0],
					})
				}
				{{ end }}
			}
		}

		// pgqAll executes the property graph query and returns a list of {{ $.Name }} entities.
		func ({{ $receiver }} *{{ $builder }}) pgqAll(ctx context.Context) ([]*{{ $.Name }}, error) {
			if {{ $receiver }}.pgMode == nil || !{{ $receiver }}.pgMode.enabled {
				return nil, fmt.Errorf("property graph mode not enabled")
			}

			query := {{ $receiver }}.buildPGQ(ctx)
			if query == nil {
				return nil, fmt.Errorf("failed to build property graph query")
			}
			
			// Apply eager loading
			{{ $receiver }}.pgqLoadEdges(query)
			
			// Execute the query
			queryStr, args := query.Query()
			rows := &sql.Rows{}
			if err := {{ $receiver }}.driver.Query(ctx, queryStr, args, rows); err != nil {
				return nil, fmt.Errorf("executing property graph query: %w", err)
			}
			defer rows.Close()
			
			var entities []*{{ $.Name }}
			if err := sql.ScanSlice(rows, &entities); err != nil {
				return nil, fmt.Errorf("scanning property graph query result: %w", err)
			}
			
			for i := range entities {
				entities[i].config = {{ $receiver }}.config
			}
			return entities, nil
		}

		// pgqCount executes the property graph query and returns the count of {{ $.Name }} entities.
		func ({{ $receiver }} *{{ $builder }}) pgqCount(ctx context.Context) (int, error) {
			if {{ $receiver }}.pgMode == nil || !{{ $receiver }}.pgMode.enabled {
				return 0, fmt.Errorf("property graph mode not enabled")
			}

			if {{ $receiver }}.pgMode.graphName == "" {
				return 0, fmt.Errorf("failed to build property graph query")
			}
			
			// Build count-specific query - don't reuse buildPGQ to avoid entity columns
			node := sqlpgq.Node("n1").Labels({{ printf "%q" $.Name }})
			
			// Apply predicates to count query as well
			if len({{ $receiver }}.predicates) > 0 {
				node = {{ $receiver }}.applyPredicatesToNode(node)
			}
			
			query := sqlpgq.Graph({{ $receiver }}.pgMode.graphName).Match(node)
			
			// Apply limit and offset
			if {{ $receiver }}.ctx != nil {
				switch limit, offset := {{ $receiver }}.ctx.Limit, {{ $receiver }}.ctx.Offset; {
				case limit != nil && offset != nil:
					query = query.Skip(*offset).Limit(*limit)
				case offset != nil:
					query = query.Skip(*offset)
				case limit != nil:
					query = query.Limit(*limit)
				}
			}
			
			// Return only count
			query = query.Return("COUNT(*)")
			
			// Execute the query
			queryStr, args := query.Query()
			rows := &sql.Rows{}
			if err := {{ $receiver }}.driver.Query(ctx, queryStr, args, rows); err != nil {
				return 0, fmt.Errorf("executing property graph count query: %w", err)
			}
			defer rows.Close()
			
			var count int
			if rows.Next() {
				if err := rows.Scan(&count); err != nil {
					return 0, fmt.Errorf("scanning property graph count result: %w", err)
				}
			}
			return count, nil
		}

		// buildPGQ builds the property graph query.
		func ({{ $receiver }} *{{ $builder }}) buildPGQ(ctx context.Context) *sqlpgq.GraphQuery {
			if {{ $receiver }}.pgMode == nil || {{ $receiver }}.pgMode.graphName == "" {
				return nil
			}
			
			// Start with the graph and match the entity node
			node := sqlpgq.Node("n1").Labels({{ printf "%q" $.Name }})
			
			// Apply predicates - convert SQL predicates to property graph conditions
			if len({{ $receiver }}.predicates) > 0 {
				// Convert SQL predicates to property graph node properties
				node = {{ $receiver }}.applyPredicatesToNode(node)
			}
			
			query := sqlpgq.Graph({{ $receiver }}.pgMode.graphName).Match(node)
			
			// Apply ordering
			if len({{ $receiver }}.order) > 0 {
				// Property graph ordering - simplified approach
				for _, ord := range {{ $receiver }}.order {
					_ = ord
				}
			}
			
			// Apply limit and offset
			if {{ $receiver }}.ctx != nil {
				switch limit, offset := {{ $receiver }}.ctx.Limit, {{ $receiver }}.ctx.Offset; {
				case limit != nil && offset != nil:
					query = query.Skip(*offset).Limit(*limit)
				case offset != nil:
					query = query.Skip(*offset)
				case limit != nil:
					query = query.Limit(*limit)
				}
			}
			
			// Return the matched node
			query = query.Return({{- range $i, $f := $.Fields -}}{{- if ne $i 0 }}, {{ end -}}"n1.{{ $f.StorageKey }}"{{- end -}})
			
			return query
		}

		// applyPredicatesToNode applies property graph predicates to the node.
		func ({{ $receiver }} *{{ $builder }}) applyPredicatesToNode(node *sqlpgq.NodePattern) *sqlpgq.NodePattern {
			// Apply property graph predicates that were captured during Where() calls
			for _, pgPred := range {{ $receiver }}.pgPredicates {
				switch pgPred.Operation {
				case "eq":
					node = node.Property(pgPred.Field, pgPred.Value)
				// TODO: Add support for other operations like neq, in, gt, etc.
				// For now, we only support equality predicates in property graphs
				}
			}
			return node
		}

		// pgqLoadEdges applies eager loading to the property graph query.
		func ({{ $receiver }} *{{ $builder }}) pgqLoadEdges(query *sqlpgq.GraphQuery) {
			{{- range $e := $.Edges }}
				if {{ $receiver }}.{{ $e.EagerLoadField }} != nil {
					// Add edge pattern for {{ $e.Name }}
					{{- if $e.Bidi }}
						query.Match(sqlpgq.From(sqlpgq.Node("n1")).Via(sqlpgq.Edge("e{{ $e.Index }}", "{{ $e.Label }}")).To(sqlpgq.Node("n{{ add $e.Index 2 }}").Labels({{ printf "%q" $e.Type.Name }})))
					{{- else if $e.IsInverse }}
						query.Match(sqlpgq.From(sqlpgq.Node("n{{ add $e.Index 2 }}")).Via(sqlpgq.Edge("e{{ $e.Index }}", "{{ $e.Label }}")).To(sqlpgq.Node("n1")))
					{{- else }}
						query.Match(sqlpgq.From(sqlpgq.Node("n1")).Via(sqlpgq.Edge("e{{ $e.Index }}", "{{ $e.Label }}")).To(sqlpgq.Node("n{{ add $e.Index 2 }}").Labels({{ printf "%q" $e.Type.Name }})))
					{{- end }}
				}
			{{- end }}
		}
	{{- end }}
{{ end }}

{{/* Extension to modify the All() method in query builders to support property graph execution */}}
{{ define "dialect/sql/query/All/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		// Check if property graph mode is enabled
		if {{ $.QueryReceiver }}.pgMode != nil && {{ $.QueryReceiver }}.pgMode.enabled {
			return {{ $.QueryReceiver }}.pgqAll(ctx)
		}
	{{- end }}
{{ end }}

{{/* Extension to modify the Count() method in query builders to support property graph execution */}}
{{ define "dialect/sql/query/Count/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		// Check if property graph mode is enabled
		if {{ $.QueryReceiver }}.pgMode != nil && {{ $.QueryReceiver }}.pgMode.enabled {
			return {{ $.QueryReceiver }}.pgqCount(ctx)
		}
	{{- end }}
{{ end }}

{{/* Extension to add pgMode to Clone() method */}}
{{ define "dialect/sql/query/Clone/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		pgMode: {{ $.QueryReceiver }}.pgMode,
		pgPredicates: append([]*PropertyGraphPredicate{}, {{ $.QueryReceiver }}.pgPredicates...),
	{{- end }}
{{ end }}

{{ define "client/fields/additional/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		{{- /* Generate property graph client fields based on the property graphs in the schema */}}
		{{- if $.PropertyGraphs }}
			{{- range $pg := $.PropertyGraphs }}
				{{ $graphName := pascal $pg.Name }}
				// {{ $graphName }} is the property graph client for the {{ $pg.Name }} graph.
				{{ $graphName }} *{{ $graphName }}Client
			{{- end }}
		{{- else }}
			{{- /* If no property graphs are defined, don't generate any fields */}}
		{{- end }}
	{{- end }}
{{ end }}

{{ define "client/additional/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		{{ $pkg := base $.Config.Package }}

		// PropertyGraphMode holds property graph execution context
		type PropertyGraphMode struct {
			graphName string
			enabled   bool
		}

		// PropertyGraphPredicate holds metadata for property graph predicate conversion
		type PropertyGraphPredicate struct {
			Field     string      // field name
			Operation string      // operation type (eq, neq, in, etc.)
			Value     interface{} // predicate value
		}

		{{- /* Generate property graph clients based on the property graphs in the schema */}}
		{{- if $.PropertyGraphs }}
			{{- range $pg := $.PropertyGraphs }}
				{{ $graphName := pascal $pg.Name }}
				
				// {{ $graphName }}Client is the property graph client for the {{ $pg.Name }} graph.
				// Usage: client.{{ $graphName }}.QueryComment().All(ctx)
				type {{ $graphName }}Client struct {
					config
				}

				{{- range $n := $.Nodes }}

					// Query{{ $n.Name }} returns a query builder for {{ $n.Name }} entities using property graph syntax.
					// The query automatically uses SQL/PGQ when executed.
					func (c *{{ $graphName }}Client) Query{{ $n.Name }}() *{{ $n.QueryName }} {
						query := &{{ $n.QueryName }}{
							config: c.config,
							ctx:    &QueryContext{Type: {{ $n.TypeName }}},
							inters: c.inters.{{ $n.Name }},
						}
						// Enable property graph mode
						query.pgMode = &PropertyGraphMode{
							graphName: {{ printf "%q" $pg.Name }},
							enabled:   true,
						}
						return query
					}

					{{ if $n.HasOneFieldID }}
					// Get{{ $n.Name }} returns a {{ $n.Name }} entity by its id using property graph query.
					func (c *{{ $graphName }}Client) Get{{ $n.Name }}(ctx context.Context, id {{ $n.ID.Type }}) (*{{ $n.Name }}, error) {
						// Build property graph query with label and ID condition: (n:Label {field: value})
						pgq := sqlpgq.Graph({{ printf "%q" $pg.Name }}).
							Match(sqlpgq.Node("n1").Labels({{ printf "%q" $n.Name }}).Property({{ printf "%q" $n.ID.Name }}, id)).
							Return({{- range $i, $f := $n.Fields -}}{{- if ne $i 0 }}, {{ end -}}"n1.{{ $f.StorageKey }}"{{- end -}})
						
						// Execute the query
						queryStr, args := pgq.Query()
						rows := &sql.Rows{}
						if err := c.driver.Query(ctx, queryStr, args, rows); err != nil {
							return nil, fmt.Errorf("executing property graph get query: %w", err)
						}
						defer rows.Close()
						
						var entities []*{{ $n.Name }}
						if err := sql.ScanSlice(rows, &entities); err != nil {
							return nil, fmt.Errorf("scanning property graph get result: %w", err)
						}
						
						if len(entities) == 0 {
							return nil, &NotFoundError{"{{ $n.Package }}"}
						}
						if len(entities) > 1 {
							return nil, &NotSingularError{"{{ $n.Package }}"}
						}
						
						entities[0].config = c.config
						return entities[0], nil
					}

					// Get{{ $n.Name }}X is like Get{{ $n.Name }}, but panics if an error occurs.
					func (c *{{ $graphName }}Client) Get{{ $n.Name }}X(ctx context.Context, id {{ $n.ID.Type }}) *{{ $n.Name }} {
						obj, err := c.Get{{ $n.Name }}(ctx, id)
						if err != nil {
							panic(err)
						}
						return obj
					}
					{{ end }}

				{{- end }}

			{{- end }}

			// initPropertyGraphClients initializes the property graph clients.
			func (c *Client) initPropertyGraphClients() {
				{{- range $pg := $.PropertyGraphs }}
					{{ $graphName := pascal $pg.Name }}
					c.{{ $graphName }} = &{{ $graphName }}Client{config: c.config}
				{{- end }}
			}
		{{- else }}
			{{- /* No property graphs defined */}}
		{{- end }}
	{{- end }}
{{ end }}

{{ define "client/init/additional/propertygraph" }}
	{{- if $.FeatureEnabled "sql/propertygraph" }}
		// Initialize property graph clients
		c.initPropertyGraphClients()
	{{- end }}
{{ end }}
